{
  "name": "mermaid-excalidraw-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Local Mermaid + Excalidraw diagram workspace",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspace @mermaid-excalidraw-sync/web dev",
    "start": "yarn workspace @mermaid-excalidraw-sync/web dev",
    "build": "yarn workspace @mermaid-excalidraw-sync/core build",
    "build:web": "yarn workspace @mermaid-excalidraw-sync/web build",
    "preview": "yarn workspace @mermaid-excalidraw-sync/web preview",
    "test": "yarn workspace @mermaid-excalidraw-sync/core test",
    "test:coverage": "yarn workspace @mermaid-excalidraw-sync/core test:coverage",
    "test:watch": "yarn workspace @mermaid-excalidraw-sync/core test:watch",
    "test:code": "eslint --max-warnings=0 --ext .js,.ts,.tsx ."
  },
  "devDependencies": {
    "@babel/core": "7.12.0",
    "@excalidraw/eslint-config": "1.0.3",
    "@typescript-eslint/eslint-plugin": "5.59.9",
    "@typescript-eslint/parser": "5.59.9",
    "eslint": "8.42.0",
    "eslint-config-prettier": "8.8.0",
    "eslint-plugin-prettier": "4.2.1",
    "prettier": "2.8.8",
    "process": "0.11.10",
    "typescript": "5.2.2",
    "vite": "5.2.8"
  },
  "resolutions": {
    "@babel/preset-env": "7.13.8"
  }
}
