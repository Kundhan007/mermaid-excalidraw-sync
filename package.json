{
  "name": "mermaid-excalidraw-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Local Mermaid + Excalidraw diagram workspace",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "frontend/*"
  ],
  "scripts": {
    "dev": "yarn workspace @mermaid-excalidraw-sync/app dev",
