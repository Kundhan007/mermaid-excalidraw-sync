{
  "compilerOptions": {
    "target": "ES2021",
    "strict": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "useDefineForClassFields": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "bundler",
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@mermaid-excalidraw-sync/converter": ["../converter/src/index.ts"],
      "@mermaid-excalidraw-sync/converter/*": ["../converter/src/*"]
    }
  },
  "include": ["./**/*"]
}
